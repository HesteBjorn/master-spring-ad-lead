# Residual RL training profile (TD3) - Idun single A100 baseline.
# Entire TFv6 is frozen; only the residual head and twin Q-networks are trained.
# Matches train_vc06_residual_td3_baseline_gpu1_4env_speedhistory.env
# except GPU assignment is injected by the Slurm wrapper.

# Parallel launcher topology - TD3 is off-policy; use 4 envs on one A100.
NUM_ENVS_PER_NODE=4
NUM_ENVS_PER_GPU=4

# Routes
TRAIN_TOWNS="12 13 12 13"
ROUTES_FOLDER=data/rl_finetuning_training_data/NonSignalizedJunctionLeftTurnEnterFlow_Interleaved2env
ROUTE_REPETITIONS=500

# CARLA / leaderboard
TRACK=MAP_QUALIFIER
FRAME_RATE=10.0
TIMEOUT=900.0
RUNTIME_TIMEOUT=900.0
LEADERBOARD_DEBUG=0
ML_CLOUD=1

# TFv6 sensor-safe CARLA threading profile
CARLA_RPC_THREADS=4
CARLA_STREAMING_THREADS=4
CARLA_SECONDARY_THREADS=4

# TD3 replay buffer / update regime
# BUFFER_SIZE=200000  # Same as Ankile
# LEARNING_STARTS=10000  # Same as Ankile
BUFFER_SIZE=1 # NO BUFFER STORED
LEARNING_STARTS=999999999 # NEVER UPDATE
BATCH_SIZE=256  # Same as Ankile
TOTAL_TIMESTEPS=2000000
SAVE_EVERY=10000

# TD3 algorithm hyperparameters
TAU=0.005  # Standard default
# EXPLORATION_NOISE=0.15
EXPLORATION_NOISE=0.0 # NO EXPLORATION NOISE
TARGET_POLICY_NOISE=0.2
TARGET_NOISE_CLIP=0.5
CRITIC_WARMUP_STEPS=50000  # Counted in critic updates.
ACTOR_LR=1e-5
CRITIC_LR=1e-4
UTD_RATIO=1  # Critic updates per collected env step; trainer multiplies by num_envs.
UTD_ACTOR=0.5  # Actor updates per collected env step.


# Special experiment related configs:
# --speed_history_len 10
# --n_step_returns 3
TRAINER_EXTRA_ARGS="
--use_residual_policy 1
--residual_route_rank 1
--residual_alpha 0.15
--residual_alpha_speed 0.35
--disable_residual_route 1


--speed_temperature 1.0
--terminal_penalty_warmup_n 20
--standstill_speed_hold_enabled 0
--standstill_speed_hold_frames 1

--max_grad_norm 5
--use_value_measurements 1

--reward_type simple_reward
--consider_tl 1
--speeding_infraction 1
--use_termination_hint 1
--use_rl_termination_hint 1
--use_perc_progress 0
--use_leave_route_done 0
--use_outside_route_lanes 1
--use_off_road_term 1
--off_road_term_perc 0.95
--use_ttc 0
--penalize_yellow_light 0
--use_comfort_infraction 0
--use_single_reward 1
--use_new_stop_sign_detector 1
--terminal_hint 1.0
--lane_distance_violation_threshold 0.3
--lane_dist_penalty_softener 1.0
--comfort_penalty_factor 0.5
--use_survival_reward 0
"
