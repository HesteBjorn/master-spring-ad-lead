# Residual RL training profile — IDUN multi-GPU.
# Entire TFv6 is frozen; only the residual head and value head are trained.
# Based on train_local_residual.env, with IDUN-specific changes mirroring
# the diff between train_parallel_singleGPU_singlescenario.env and train_parallel_idun.env.

# Parallel launcher topology is set by the SLURM script — do not set here.
# NUM_ENVS_PER_NODE and GPU_IDS are injected by train_tfv6_ppo_parallell_slurm.slurm.
# Set NUM_ENVS_PER_GPU=2 here as a hint; the slurm script line 63 must not override it
# (remove the TEMPORARY OVERRIDE line or set it to 2 for residual runs).
NUM_ENVS_PER_GPU=2

# Routes — 5 towns with NonSignalizedJunctionLeftTurnEnterFlow route files.
# Town10 excluded (only 1 usable route). 30 entries use each town's 6
# available files (00-05) exactly once, ordered so 2-env/GPU rank pairs mix
# heavy towns (12/13) with lighter towns (3/4/5).
TRAIN_TOWNS="12 4 13 5 12 3 13 5 12 4 13 5 12 3 13 4 12 3 13 5 12 4 13 3 5 4 3 5 4 3"
ROUTES_FOLDER=data/rl_finetuning_training_data/NonSignalizedJunctionLeftTurnEnterFlow
ROUTE_REPETITIONS=100

# CARLA / leaderboard
TRACK=MAP_QUALIFIER
FRAME_RATE=10.0
TIMEOUT=900.0
RUNTIME_TIMEOUT=900.0
LEADERBOARD_DEBUG=0
ML_CLOUD=1
USE_TRAJ_SYNC_PPO=0

# TFv6 sensor-safe CARLA threading profile (reduced per-instance for multi-GPU nodes)
CARLA_RPC_THREADS=2
CARLA_STREAMING_THREADS=2
CARLA_SECONDARY_THREADS=1

# PPO update regime — STEPS_PER_ENV auto-scales batch with env count:
#   4 GPUs × 2 envs:  TOTAL_BATCH_SIZE = 8  × 256 = 2048,  TOTAL_MINIBATCH_SIZE = 512
#   8 GPUs × 2 envs:  TOTAL_BATCH_SIZE = 16 × 256 = 4096,  TOTAL_MINIBATCH_SIZE = 1024
STEPS_PER_ENV=256
UPDATE_EPOCHS=3
TOTAL_TIMESTEPS=10000000

# --value_head_init_file outputs/rl_logs/TFV6_PPO_LOCAL_only_NSLTEF_fixcritic/model_eval_000000489.pth
TRAINER_EXTRA_ARGS="
--use_residual_policy 1
--residual_route_rank 1
--residual_alpha 0.15
--residual_alpha_speed 0.35
--disable_residual_route 1

--value_head_lr_mult 20.0
--clip_vloss 0
--speed_temperature 1.0
--terminal_penalty_warmup_n 20
--standstill_speed_hold_enabled 0
--standstill_speed_hold_frames 1
--stream_obs_minibatches_from_cpu_to_save_gpu_memory 0

--log_std_init -4.0
--log_std_init_route -2
--log_std_init_speed -1
--log_std_min -5.0
--disable_learned_noise_head 1

--ent_coef 0
--critic_updates_shared_features 0
--learning_rate 1e-5
--lr_schedule linear
--clip_coef 0.2
--max_grad_norm 0.3
--target_kl 0.1
--num_value_measurements 10
--norm_adv 1

--reward_type simple_reward
--consider_tl 1
--speeding_infraction 1
--use_termination_hint 1
--use_rl_termination_hint 1
--use_perc_progress 0
--use_leave_route_done 0
--use_outside_route_lanes 1
--use_off_road_term 1
--off_road_term_perc 0.95
--use_ttc 0
--penalize_yellow_light 0
--use_comfort_infraction 0
--use_single_reward 1
--use_new_stop_sign_detector 1
--terminal_hint 1.0
--lane_distance_violation_threshold 0.3
--lane_dist_penalty_softener 1.0
--comfort_penalty_factor 0.5
--use_survival_reward 0
"
