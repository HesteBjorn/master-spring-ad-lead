# Weekend local watchdog run profile (stability-oriented).
# Intended for single-env local TFv6 PPO runs with reduced KL/clipfrac spikes.

# Watchdog controls
NO_PROGRESS_TIMEOUT_SECONDS=1000
SPS_THRESHOLD=9
SPS_CONSECUTIVE=3
CARLA_BOOT_WAIT_SECONDS=30
LEADERBOARD_READY_TIMEOUT_SECONDS=180

# Long-run sizing
TARGET_HOURS=72
ASSUMED_SPS=9

# Route selection
ROUTE_PROFILE=debug_suite
DEBUG_SUITE_TOWNS=Town01,Town02,Town03,Town04,Town05,Town06
REPETITIONS=300

# PPO update regime (single-env local):
# - increase data per update to reduce gradient noise
# - reduce per-update aggressiveness to improve KL stability
TOTAL_BATCH_SIZE=2048
TOTAL_MINIBATCH_SIZE=128
UPDATE_EPOCHS=2

# Trainer overrides (keeps reward stack aligned with your current CaRL-like setup).
TRAINER_EXTRA_ARGS="--correlated_noise_rho 0.95 --log_std_init -4.5 --learning_rate 5e-6 --lr_schedule linear --clip_coef 0.05 --max_grad_norm 0.3 --target_kl 0.05 --norm_adv 1 --clip_vloss 1 --reward_type simple_reward --consider_tl 1 --speeding_infraction 1 --use_termination_hint 1 --use_rl_termination_hint 1 --use_perc_progress 1 --use_leave_route_done 0 --use_outside_route_lanes 1 --use_off_road_term 1 --off_road_term_perc 0.95 --use_ttc 1 --penalize_yellow_light 0 --use_comfort_infraction 1 --use_single_reward 1 --use_new_stop_sign_detector 1 --terminal_hint 1.0 --lane_distance_violation_threshold 0.0 --lane_dist_penalty_softener 1.0 --comfort_penalty_factor 0.5 --use_survival_reward 0"

# Alternative from first stdev_head run with correlated_noise_rho=0.8 as default
# TRAINER_EXTRA_ARGS="--learning_rate 5e-6 --lr_schedule linear --clip_coef 0.05 --max_grad_norm 0.3 --target_kl 0.05 --norm_adv 1 --clip_vloss 1 --reward_type simple_reward --consider_tl 1 --speeding_infraction 1 --use_termination_hint 1 --use_rl_termination_hint 1 --use_perc_progress 1 --use_leave_route_done 0 --use_outside_route_lanes 1 --use_off_road_term 1 --off_road_term_perc 0.95 --use_ttc 1 --penalize_yellow_light 0 --use_comfort_infraction 1 --use_single_reward 1 --use_new_stop_sign_detector 1 --terminal_hint 1.0 --lane_distance_violation_threshold 0.0 --lane_dist_penalty_softener 1.0 --comfort_penalty_factor 0.5 --use_survival_reward 0"

