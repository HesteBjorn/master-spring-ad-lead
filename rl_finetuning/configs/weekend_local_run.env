# Weekend local watchdog run profile.
# Used by both `run_tfv6_watchdog_overnight.sh` and `train_long_local.sh`.

# Watchdog controls
NO_PROGRESS_TIMEOUT_SECONDS=300
SPS_THRESHOLD=10
SPS_CONSECUTIVE=3
CARLA_BOOT_WAIT_SECONDS=30
LEADERBOARD_READY_TIMEOUT_SECONDS=180

# Long-run sizing
TARGET_HOURS=70
ASSUMED_SPS=10

# Route selection
ROUTE_PROFILE=debug_suite
DEBUG_SUITE_TOWNS=Town01,Town02,Town03,Town04,Town05,Town06
REPETITIONS=300

# Trainer overrides to align with CaRL v1.1-style optimization/reward shaping,
# while keeping TFv6-specific scale (small batch, single-env local run).
TRAINER_EXTRA_ARGS="--learning_rate 1e-5 --lr_schedule linear --reward_type simple_reward --consider_tl 1 --speeding_infraction 1 --use_termination_hint 1 --use_perc_progress 1 --use_leave_route_done 0 --use_outside_route_lanes 1 --use_off_road_term 1 --off_road_term_perc 0.95 --use_ttc 1 --penalize_yellow_light 0 --use_comfort_infraction 1 --use_single_reward 1 --use_rl_termination_hint 1 --use_survival_reward 0"
