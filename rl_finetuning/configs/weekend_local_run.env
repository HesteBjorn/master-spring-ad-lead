# Weekend local watchdog run profile.
# Used by both `run_tfv6_watchdog_overnight.sh` and `train_long_local.sh`.

# Watchdog controls
NO_PROGRESS_TIMEOUT_SECONDS=300
SPS_THRESHOLD=10
SPS_CONSECUTIVE=3
CARLA_BOOT_WAIT_SECONDS=30
LEADERBOARD_READY_TIMEOUT_SECONDS=180

# Long-run sizing
TARGET_HOURS=70
ASSUMED_SPS=10

# Route selection
ROUTE_PROFILE=debug_suite
DEBUG_SUITE_TOWNS=Town01,Town02,Town03,Town04,Town05,Town06
REPETITIONS=300
