# Parallel TFv6 PPO profile for a single-GPU local node.
# Mirrors weekend_local_run_stable.env trainer settings, but uses
# variable names expected by train_tfv6_ppo_parallell.sh.

# Parallel launcher topology is specified in the SLURM script, so disable here.
# NUM_ENVS_PER_NODE=2
# NUM_ENVS_PER_GPU=2
# GPU_IDS="0"

# Route assignment for parallel launcher:
# Needs at least NUM_ENVS_PER_NODE entries.
TRAIN_TOWNS="1 2 3 4 5 6 7 10 1 2 3 4 5 6 7 10 1 2 3 4 5 6 7 10 1 2 3 4 5 6 7 10"  # "3 3"
ROUTES_FOLDER=1000_meters_old_scenarios_02 # debug_routes_with_scenarios
ROUTE_REPETITIONS=100  # 300

# CARLA / leaderboard
TRACK=MAP_QUALIFIER
FRAME_RATE=10.0
TIMEOUT=900.0
RUNTIME_TIMEOUT=900.0
LEADERBOARD_DEBUG=0
ML_CLOUD=0
USE_TRAJ_SYNC_PPO=0

# TFv6 sensor-safe CARLA threading profile (same defaults as launcher)
CARLA_RPC_THREADS=8
CARLA_STREAMING_THREADS=8
CARLA_SECONDARY_THREADS=8

# PPO update regime (kept aligned with weekend_local_run_stable.env)
STEPS_PER_ENV=256  # If STEPS_PER_ENV is set, then TOTAL_BATCH_SIZE and minibatch size is ignored and determined based on this parameter. TOTAL_BATCH_SIZE = (NUM_ENVS_PER_NODE * NUM_NODES) * STEPS_PER_ENV, TOTAL_MINIBATCH_SIZE = TOTAL_BATCH_SIZE / 4
# TOTAL_BATCH_SIZE=6144 # Fallback when STEPS_PER_ENV is unset.
# TOTAL_MINIBATCH_SIZE=1536  # Fallback when STEPS_PER_ENV is unset.
UPDATE_EPOCHS=2
TOTAL_TIMESTEPS=10000000

# Trainer overrides (keeps reward stack aligned with your current CaRL-like setup).
TRAINER_EXTRA_ARGS="--correlated_noise_rho 0.95 --log_std_init -4.5 --ent_coef 3e-5 --learning_rate 5e-6 --lr_schedule linear --clip_coef 0.05 --max_grad_norm 0.3 --target_kl 0.05 --num_value_measurements 10 --norm_adv 1 --clip_vloss 1 --reward_type simple_reward --consider_tl 1 --speeding_infraction 1 --use_termination_hint 1 --use_rl_termination_hint 1 --use_perc_progress 1 --use_leave_route_done 0 --use_outside_route_lanes 1 --use_off_road_term 1 --off_road_term_perc 0.95 --use_ttc 1 --penalize_yellow_light 0 --use_comfort_infraction 1 --use_single_reward 1 --use_new_stop_sign_detector 1 --terminal_hint 1.0 --lane_distance_violation_threshold 0.0 --lane_dist_penalty_softener 1.0 --comfort_penalty_factor 0.5 --use_survival_reward 0"
