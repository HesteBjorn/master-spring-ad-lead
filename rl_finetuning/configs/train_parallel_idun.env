# Parallel TFv6 PPO profile for a single-GPU local node.
# Mirrors weekend_local_run_stable.env trainer settings, but uses
# variable names expected by train_tfv6_ppo_parallell.sh.

# Parallel launcher topology is specified in the SLURM script, so disable here.
# NUM_ENVS_PER_NODE=2
# NUM_ENVS_PER_GPU=2
# GPU_IDS="0"

# Route assignment for parallel launcher:
# Needs at least NUM_ENVS_PER_NODE entries.
TRAIN_TOWNS="12 13 3 4 5 10 12 13 3 4 5 10 12 13 3 4 5 10 12 13 3 4 5 10 12 13 3 4 5 10" # Only towns with route files in NonSignalizedJunctionLeftTurnEnterFlow. Old list: '12 13 1 2 3 4 5 7 6 10 12 13 1 2 3 4 5 7 6 10 12 13 1 2 3 4 5 7 6 10 12 13 1 2 3 4 5 7 6 10'
ROUTES_FOLDER=data/rl_finetuning_training_data/NonSignalizedJunctionLeftTurnEnterFlow  # 3rd_party/CaRL/CARLA/custom_leaderboard/leaderboard/data/rl_finetuning_1000_meters_alltypes_dense80
ROUTE_REPETITIONS=100  # 300

# CARLA / leaderboard
TRACK=MAP_QUALIFIER
FRAME_RATE=10.0
TIMEOUT=900.0
RUNTIME_TIMEOUT=900.0
LEADERBOARD_DEBUG=0
ML_CLOUD=1
USE_TRAJ_SYNC_PPO=0

# TFv6 sensor-safe CARLA threading profile (same defaults as launcher)
CARLA_RPC_THREADS=2
CARLA_STREAMING_THREADS=2
CARLA_SECONDARY_THREADS=1

# PPO update regime (kept aligned with weekend_local_run_stable.env)
STEPS_PER_ENV=256  # If STEPS_PER_ENV is set, then TOTAL_BATCH_SIZE and minibatch size is ignored and determined based on this parameter. TOTAL_BATCH_SIZE = (NUM_ENVS_PER_NODE * NUM_NODES) * STEPS_PER_ENV, TOTAL_MINIBATCH_SIZE = TOTAL_BATCH_SIZE / 4
# TOTAL_BATCH_SIZE=6144 # Fallback when STEPS_PER_ENV is unset.
# TOTAL_MINIBATCH_SIZE=1536  # Fallback when STEPS_PER_ENV is unset.
UPDATE_EPOCHS=2
TOTAL_TIMESTEPS=10000000

# Trainer overrides (keeps reward stack aligned with your current CaRL-like setup).
TRAINER_EXTRA_ARGS="
--route_sampling_technique lowrank_diag_route_sampling
--lowrank_route_rank 4
--lowrank_route_std_init 0.015
--log_std_init -4
--log_std_init_route -50
--log_std_init_speed -3.5
--log_std_min -50
--correlated_noise_rho 0.95
--heading_amplitude1_std_init 0.09
--heading_amplitude2_std_init 0.04
--path_std_base_frac 1
--disable_learned_noise_head 1
--ent_coef 0
--critic_updates_shared_features 0
--use_kl_to_reference 1
--kl_to_reference_coef 1e-4
--learning_rate 5e-7
--lr_schedule linear
--clip_coef 0.1
--max_grad_norm 0.3
--target_kl 0.1
--num_value_measurements 10
--norm_adv 1
--clip_vloss 1
--reward_type simple_reward
--consider_tl 1
--speeding_infraction 1
--use_termination_hint 1
--use_rl_termination_hint 1
--use_perc_progress 1
--use_leave_route_done 0
--use_outside_route_lanes 1
--use_off_road_term 1
--off_road_term_perc 0.95
--use_ttc 1
--penalize_yellow_light 0
--use_comfort_infraction 1
--use_single_reward 1
--use_new_stop_sign_detector 1
--terminal_hint 1.0
--lane_distance_violation_threshold 0.0
--lane_dist_penalty_softener 1.0
--comfort_penalty_factor 0.5
--use_survival_reward 0
"
# --value_head_init_file outputs/rl_logs/TFV6_PPO_PARALLEL_LOCAL_NEWTRAJSAMPLING_onlyfailscenarios/model_latest_000000712.pth
