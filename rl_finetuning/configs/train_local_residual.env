# Residual RL training profile — single GPU, single scenario.
# Entire TFv6 is frozen; only the residual head and value head are trained.
# Based on train_parallel_singleGPU_singlescenario.env.
#
# Parameters removed vs. the normal decoder-finetuning config:
#   route_sampling_technique, lowrank_route_rank, lowrank_route_std_init,
#   correlated_noise_rho, heading_amplitude1/2_std_init, path_std_base_frac,
#   use_kl_to_reference, kl_to_reference_coef, train_planning_decoder_only
#   (all are either forced-off by use_residual_policy or only apply to the
#    decoder-finetuning path).

# Parallel launcher topology
NUM_ENVS_PER_NODE=2
NUM_ENVS_PER_GPU=2
GPU_IDS="0"

# Routes
TRAIN_TOWNS="12 13"
ROUTES_FOLDER=data/rl_finetuning_training_data/NonSignalizedJunctionLeftTurnEnterFlow
ROUTE_REPETITIONS=500

# CARLA / leaderboard
TRACK=MAP_QUALIFIER
FRAME_RATE=10.0
TIMEOUT=900.0
RUNTIME_TIMEOUT=900.0
LEADERBOARD_DEBUG=0
ML_CLOUD=1
USE_TRAJ_SYNC_PPO=0

# TFv6 sensor-safe CARLA threading profile
CARLA_RPC_THREADS=8
CARLA_STREAMING_THREADS=8
CARLA_SECONDARY_THREADS=8

# PPO update regime
TOTAL_BATCH_SIZE=2048
TOTAL_MINIBATCH_SIZE=256
# UPDATE_EPOCHS=1
UPDATE_EPOCHS=3
TOTAL_TIMESTEPS=10000000

TRAINER_EXTRA_ARGS="
--use_residual_policy 1
--residual_route_rank 1
--residual_alpha 0.15
--residual_alpha_speed 0.35
--disable_residual_route 1

--value_head_init_file outputs/rl_logs/TFV6_PPO_LOCAL_only_NSLTEF_fixcritic/model_eval_000000489.pth
--value_head_lr_mult 20.0
--clip_vloss 0
--speed_temperature 1.0
--terminal_penalty_warmup_n 20
--standstill_speed_hold_enabled 0
--standstill_speed_hold_frames 1
--stream_obs_minibatches_from_cpu_to_save_gpu_memory 1

--log_std_init -4.0
--log_std_init_route -2
--log_std_init_speed -2
--log_std_min -5.0
--disable_learned_noise_head 1

--ent_coef 0
--critic_updates_shared_features 0
--learning_rate 1e-5
--lr_schedule linear
--clip_coef 0.2
--max_grad_norm 0.3
--target_kl 0.1
--num_value_measurements 10
--norm_adv 1

--reward_type simple_reward
--consider_tl 1
--speeding_infraction 1
--use_termination_hint 1
--use_rl_termination_hint 1
--use_perc_progress 0
--use_leave_route_done 0
--use_outside_route_lanes 1
--use_off_road_term 1
--off_road_term_perc 0.95
--use_ttc 0
--penalize_yellow_light 0
--use_comfort_infraction 0
--use_single_reward 1
--use_new_stop_sign_detector 1
--terminal_hint 1.0
--lane_distance_violation_threshold 0.3
--lane_dist_penalty_softener 1.0
--comfort_penalty_factor 0.5
--use_survival_reward 0
"
